// Create and switch to a temp/build directory before compiling
system("mkdir -p ../build");
cd("../build");

loadModel(Modelica, {"4.1.0"});
loadFile("../libTES.mo");
loadFile("../System_LMO.mo");


// Set the linearization dump language to Python
setCommandLineOptions("--linearizationDumpLanguage=python --tearingStrictness=veryStrict");


//------------------------------
// Step 1: Run fast/coarse simulation to reach equilibrium

simulate(System_LMO, 
  startTime = 0.0, 
  stopTime = 10, 
  numberOfIntervals = 1e5, 
  tolerance = 1e-6,
  outputFormat = "mat",
  simflags = "-overrideFile=../parameters/params_lmo_v1_mod_tes.txt"
);

//  simflags = ""

// Step 2: Rerun with fine resolution starting from the final values of Step 1
